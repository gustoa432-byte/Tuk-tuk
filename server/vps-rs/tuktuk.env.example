# TukTuk VPS environment (template)
# Install on server as /etc/tuktuk.env with: chmod 600 /etc/tuktuk.env
# Referenced by systemd: EnvironmentFile=/etc/tuktuk.env
#
# Fill in real secrets on the VPS only. Never commit filled values.

# --- bind ---
TUKTUK_HOST=0.0.0.0
TUKTUK_PORT=8080

# --- libSQL (Oracle + mesh share one file) ---
# Absolute path; directory must be writable by the service user.
TUKTUK_DB=/opt/tuktuk/tuktuk.db

# --- JWT (required for /contacts/* and /v1/oracle/*) ---
# Generate once: openssl rand -hex 32
# Changing this invalidates all existing client sessions (re-auth required).
TUKTUK_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- Email OTP (STARTTLS) ---
# Leave blank to keep OTP in journal via TUKTUK_OTP_DEV_LOG.
TUKTUK_SMTP_HOST=
TUKTUK_SMTP_PORT=587
TUKTUK_SMTP_USER=
TUKTUK_SMTP_PASS=
TUKTUK_SMTP_FROM=TukTuk <noreply@example.com>

# --- Telegram Mini App / Bot API ---
TUKTUK_TELEGRAM_BOT_TOKEN=

# Chat/channel id for POST /v1/telemetry/upload → sendDocument (no disk store)
TUKTUK_TELEGRAM_FEEDBACK_CHAT_ID=

# false in production (default in binary). true|1 only for local SMTP-less debugging (may return devCode).
TUKTUK_OTP_DEV_LOG=false
